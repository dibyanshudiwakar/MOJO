{
  "version": "1.0.0",
  "note": "One JSON Schema per prompt name in config/agent-prompts.v1.json. A model response is untrusted input: it is about to be persisted, hashed, bound to a gate approval and read by the next agent. app/agents/artefact.py validates against these before believing an answer, and treats an invalid one exactly like no answer -- so a schema here is a safety boundary, not documentation. Keys match prompt names exactly; tests/test_agent_response_schemas.py enforces that both ways. maxItems caps exist to bound a pathological response, not to express a business limit.",
  "schemas": {
    "agent/ace-analysis/semantic-model": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Semantic model fragment for one ACE source file",
      "description": "Produced per source file so a request fits the gateway's response limit; merged deterministically. Mirrors ACEParser's own shape, scoped to one file, so the model-authored and computed fragments are interchangeable.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "flows": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "path",
              "nodes"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "nodes": {
                "type": "array",
                "maxItems": 512,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "type"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "properties": {
                      "type": "object"
                    }
                  }
                }
              },
              "connections": {
                "type": "array",
                "maxItems": 1024,
                "items": {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "string"
                    },
                    "to": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "subflows": {
          "type": "array",
          "maxItems": 64
        },
        "esql": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "modules": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 256
              },
              "procedures": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 256
              },
              "functions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 256
              },
              "databases": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 256
              },
              "calls": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 512
              },
              "assignments": {
                "type": "array",
                "maxItems": 1024,
                "description": "The SET statements, resolved. This is what the generated transformer bodies are built from, so target/source are paths into the message tree, not free text.",
                "items": {
                  "type": "object",
                  "required": [
                    "target",
                    "kind"
                  ],
                  "properties": {
                    "target": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1
                    },
                    "source": {
                      "type": [
                        "array",
                        "null"
                      ],
                      "items": {
                        "type": "string"
                      }
                    },
                    "literal": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ],
                      "description": "A numeric or boolean literal may arrive as a JSON number or boolean; the agent stores it as text."
                    },
                    "kind": {
                      "enum": [
                        "COPY",
                        "LITERAL",
                        "EXPRESSION",
                        "UNRESOLVED"
                      ]
                    },
                    "esql": {
                      "type": "string"
                    },
                    "java": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 2000
                    }
                  }
                }
              }
            }
          }
        },
        "maps": {
          "type": "array",
          "maxItems": 64
        },
        "schemas": {
          "type": "array",
          "maxItems": 128
        },
        "policies": {
          "type": "array",
          "maxItems": 64
        },
        "interfaces": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": [
              "protocol"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "node": {
                "type": "string"
              },
              "protocol": {
                "enum": [
                  "HTTP",
                  "SOAP",
                  "MQ",
                  "KAFKA",
                  "FILE",
                  "DATABASE",
                  "SCHEDULED",
                  "UNKNOWN"
                ]
              },
              "endpoint": {
                "type": "string"
              }
            }
          }
        },
        "dependencies": {
          "type": "array",
          "maxItems": 512
        },
        "behaviour": {
          "type": "object"
        },
        "ambiguities": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": [
              "question"
            ],
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string"
              },
              "impact": {
                "type": "string"
              },
              "evidenceReference": {
                "type": "string"
              },
              "status": {
                "type": "string"
              }
            }
          }
        },
        "backend_type": {
          "type": "string"
        },
        "backend_properties": {
          "type": "object"
        }
      }
    },
    "agent/ace-analysis/ambiguity-triage": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": [
        "ambiguities"
      ],
      "properties": {
        "ambiguities": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": [
              "question",
              "owner",
              "impact"
            ],
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "impact": {
                "type": "string",
                "minLength": 1
              },
              "evidenceReference": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "agent/clarification/suggested-answers": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": [
        "suggestions"
      ],
      "properties": {
        "suggestions": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": [
              "question",
              "suggested_answer",
              "confidence",
              "severity"
            ],
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1
              },
              "suggested_answer": {
                "type": "string"
              },
              "confidence": {
                "type": "string",
                "enum": ["HIGH", "MEDIUM", "LOW"]
              },
              "severity": {
                "type": "string",
                "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"],
                "description": "What a wrong answer would cost. Auto mode puts a question to a person only when this is CRITICAL and confidence is not HIGH."
              },
              "settled_by": {
                "type": "string",
                "description": "The ref (D1, D2, ...) of an earlier decision in _precedents that already settles this question, or empty."
              },
              "caveat": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "agent/repository-intake/inventory": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Repository inventory and intake gaps",
      "type": "object",
      "required": [
        "inventory"
      ],
      "properties": {
        "inventory": {
          "type": "object",
          "properties": {
            "files": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 4096
            },
            "flows": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 512
            },
            "subflows": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 512
            },
            "esql": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 512
            },
            "schemas": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 512
            },
            "maps": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 512
            },
            "policies": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 512
            }
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 128
        }
      }
    },
    "agent/repository-intake/gap-triage": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": [
        "ranked_gaps"
      ],
      "properties": {
        "ranked_gaps": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": [
              "gap"
            ],
            "properties": {
              "gap": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "enum": [
                  "BLOCKING",
                  "MAJOR",
                  "MINOR",
                  "UNKNOWN"
                ]
              },
              "closes_with": {
                "type": "string"
              }
            }
          }
        },
        "notes": {
          "type": [
            "string",
            "array",
            "null"
          ]
        }
      }
    },
    "agent/framework-baseline/standards": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Target framework standards extracted from the reference project",
      "type": "object",
      "required": [
        "standards"
      ],
      "properties": {
        "standards": {
          "type": "object",
          "properties": {
            "build": {
              "type": "object",
              "properties": {
                "tool": {
                  "enum": [
                    "MAVEN",
                    "GRADLE",
                    "UNKNOWN"
                  ]
                },
                "javaVersion": {
                  "type": [
                    "string",
                    "number",
                    "null"
                  ]
                },
                "springBootVersion": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "dependencies": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 512
            },
            "projectStructure": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 2048
            },
            "api": {
              "type": "array",
              "maxItems": 256
            },
            "messaging": {
              "type": "array",
              "maxItems": 256
            },
            "security": {
              "type": "array",
              "maxItems": 256
            },
            "configuration": {
              "type": "array",
              "maxItems": 256
            },
            "logging": {
              "type": "array",
              "maxItems": 256
            },
            "errorHandling": {
              "type": "array",
              "maxItems": 256
            },
            "observability": {
              "type": "array",
              "maxItems": 256
            }
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 128
        }
      }
    },
    "agent/framework-baseline/convention-conflict-triage": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": [
        "conflicts"
      ],
      "properties": {
        "conflicts": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": [
              "conflict"
            ],
            "properties": {
              "conflict": {
                "type": "string",
                "minLength": 1
              },
              "decision_required": {
                "type": "string"
              },
              "owner": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "agent/migration-specification/authoring": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "The migration specification",
      "description": "Validated a second time against schemas/migration-specification.schema.json by SpecificationService before it is stored, so this schema only has to catch a shape the authoring step cannot use at all.",
      "type": "object",
      "properties": {
        "specification": {
          "type": "object"
        },
        "springModules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 256
        },
        "approvedDependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 512
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 128
        }
      },
      "anyOf": [
        {
          "required": [
            "specification"
          ]
        },
        {
          "required": [
            "springModules"
          ]
        }
      ]
    },
    "agent/migration-specification/section": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "One section of the migration specification",
      "description": "The full document overran the gateway's output limit when authored in one reply, so it is authored a section at a time. The section's own shape is checked by the agent against its slice of schemas/migration-specification.schema.json inside the retry loop; this schema only has to catch an answer that is not a section at all.",
      "type": "object",
      "properties": {
        "section": {
          "type": "string",
          "enum": ["source", "interfaces", "behaviour", "target", "mappings", "tests"]
        },
        "content": {}
      },
      "required": ["section", "content"]
    },
    "agent/planning/mapping-catalogue": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "ACE construct to Spring pattern mappings",
      "description": "Replaces the hardcoded DEFAULT_MAPPINGS dict. spring_pattern is open rather than enumerated on purpose -- the point of moving this to the model is that a construct with no entry in that dict can still be mapped -- but boundary stays closed because generation and the G3 package both branch on it.",
      "type": "object",
      "required": [
        "mappings"
      ],
      "properties": {
        "mappings": {
          "type": "array",
          "maxItems": 2048,
          "items": {
            "type": "object",
            "required": [
              "source_reference",
              "ace_construct",
              "spring_pattern",
              "target_module"
            ],
            "properties": {
              "source_reference": {
                "type": "string",
                "minLength": 1
              },
              "ace_construct": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "mapping_key": {
                "type": "string"
              },
              "spring_pattern": {
                "type": "string",
                "minLength": 1
              },
              "target_module": {
                "type": "string",
                "minLength": 1
              },
              "boundary": {
                "enum": [
                  "GENERATED",
                  "HAND_WRITTEN_PROTECTED"
                ]
              },
              "tests": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 32
              },
              "rationale": {
                "type": "string",
                "maxLength": 300
              }
            }
          }
        },
        "unsupported": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "object",
            "required": [
              "source_reference",
              "ace_construct",
              "reason"
            ],
            "properties": {
              "source_reference": {
                "type": "string"
              },
              "ace_construct": {
                "type": "string",
                "maxLength": 160
              },
              "reason": {
                "type": "string",
                "maxLength": 300
              },
              "owner": {
                "type": "string",
                "maxLength": 120
              },
              "severity": {
                "enum": [
                  "CRITICAL",
                  "HIGH",
                  "MEDIUM",
                  "LOW"
                ],
                "description": "What leaving this construct out would cost. Auto mode plans around anything below CRITICAL."
              },
              "risk": {
                "type": "string",
                "maxLength": 300,
                "description": "One sentence on the risk of leaving it out."
              }
            }
          }
        },
        "risks": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "object",
            "required": [
              "category",
              "severity",
              "statement"
            ],
            "properties": {
              "category": {
                "type": "string"
              },
              "severity": {
                "enum": [
                  "CRITICAL",
                  "HIGH",
                  "MEDIUM",
                  "LOW"
                ]
              },
              "source_reference": {
                "type": "string"
              },
              "statement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "response": {
                "type": "string",
                "maxLength": 400
              },
              "owner": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "agent/planning/implementation-plan": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Ordered implementation tasks",
      "type": "object",
      "required": [
        "tasks"
      ],
      "properties": {
        "tasks": {
          "type": "array",
          "maxItems": 2048,
          "items": {
            "type": "object",
            "required": [
              "id",
              "source_reference",
              "spring_pattern"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "sequence": {
                "type": "integer",
                "minimum": 1
              },
              "source_reference": {
                "type": "string"
              },
              "mapping_id": {
                "type": "string"
              },
              "spring_pattern": {
                "type": "string"
              },
              "target_module": {
                "type": "string"
              },
              "boundary": {
                "enum": [
                  "GENERATED",
                  "HAND_WRITTEN_PROTECTED"
                ]
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 64
              },
              "tests": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 32
              },
              "acceptance": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 32
              },
              "security_checks": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 32
              },
              "rollback_checkpoint": {
                "type": "string"
              }
            }
          }
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 64
        }
      }
    },
    "agent/planning/risk-assessment": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": [
        "risks"
      ],
      "properties": {
        "risks": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": [
              "statement"
            ],
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "enum": [
                  "HIGH",
                  "MEDIUM",
                  "LOW"
                ]
              },
              "response": {
                "type": "string"
              },
              "owner": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "agent/code-generation/business-logic-synthesis": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Targeted edits filling generated placeholder bodies",
      "description": "Edits, not whole files, and deliberately so: the model never has to reproduce bytes it was not shown, and an old_str that does not match the real file is skipped rather than corrupting it. This is the ESQL-to-Java step -- it replaces the TODO bodies the deterministic generator leaves behind.",
      "type": "object",
      "required": [
        "edits"
      ],
      "properties": {
        "edits": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "object",
            "required": [
              "path",
              "old_str",
              "new_str"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400,
                "description": "Project-relative. Confined by workspace.resolve() before any write -- the model cannot direct a write outside the project.",
                "pattern": "^[^/\\\\][^:*?\"<>|]*$"
              },
              "old_str": {
                "type": "string",
                "minLength": 1
              },
              "new_str": {
                "type": "string",
                "maxLength": 20000
              },
              "why": {
                "type": "string",
                "maxLength": 1000
              }
            }
          }
        }
      }
    },
    "agent/code-generation/file-synthesis": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "A whole generated source file",
      "description": "One file per call, for the files the model authors outright rather than filling in. 'content' is written to disk, hashed into the provenance manifest and then compiled, so a partial or fenced response is a schema failure rather than something to repair later.",
      "type": "object",
      "required": [
        "path",
        "content"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "description": "Project-relative, forward slashes. Confined by workspace.resolve() before any write.",
          "pattern": "^[^/\\\\][^:*?\"<>|]*$"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000,
          "description": "minLength is 1 because an empty file is not an authored one. The agent used to filter empty content out and then generate the whole project deterministically instead, so one blank file silently discarded the other forty the model had authored. Emptiness is now a violation on that single file, which is re-asked on its own."
        },
        "language": {
          "type": "string"
        },
        "provenance": {
          "type": "object",
          "description": "Which ACE construct this file implements, so the manifest stays traceable to the approved plan.",
          "properties": {
            "source_reference": {
              "type": "string"
            },
            "esql_module": {
              "type": "string"
            },
            "spring_pattern": {
              "type": "string"
            }
          }
        },
        "action_items": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 64
        }
      }
    },
    "agent/code-generation/quality-failure-triage": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "failures": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "properties": {
              "check": {
                "type": "string"
              },
              "cause": {
                "type": "string"
              },
              "remedy": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "agent/test-engineering/case-design": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Differential test cases",
      "description": "minItems is 1 because zero differential cases is not an answer: the whole point of this artefact is to find where the two systems behave differently, and an empty set proves nothing. The agent used to accept an empty array and substitute its own one-nominal-case-per-interface derivation; with no fallback left, emptiness is a schema violation so the model is re-asked with the violation rather than quietly replaced.",
      "type": "object",
      "required": [
        "cases"
      ],
      "properties": {
        "cases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "input": {},
              "headers": {
                "type": "object"
              },
              "timing": {
                "type": "object"
              },
              "side_effect_observations": {
                "type": "array",
                "maxItems": 64
              },
              "secure_references": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 64
              },
              "covers": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 64
              }
            }
          }
        },
        "policy": {
          "type": "object"
        }
      }
    },
    "agent/test-engineering/case-coverage-review": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "uncovered": {
          "type": "array",
          "items": {
