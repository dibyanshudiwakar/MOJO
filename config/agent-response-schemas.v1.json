          },
          "maxItems": 256
        },
        "cases": {
          "type": "array",
          "maxItems": 512
        }
      }
    },
    "agent/variance-analysis/findings": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Behavioural variances and their materiality",
      "description": "The byte-level comparison stays deterministic -- it is the evidence. The model judges materiality and explains each divergence; it does not decide whether the bytes differ.",
      "type": "object",
      "required": [
        "findings"
      ],
      "properties": {
        "findings": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "required": [
              "path",
              "kind",
              "severity"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "VALUE",
                  "TYPE",
                  "STRUCTURAL",
                  "TIMING",
                  "SIDE_EFFECT"
                ]
              },
              "severity": {
                "enum": [
                  "HIGH",
                  "MEDIUM",
                  "LOW"
                ]
              },
              "material": {
                "type": "boolean"
              },
              "expected": {},
              "actual": {},
              "explanation": {
                "type": "string",
                "maxLength": 2000
              }
            }
          }
        }
      }
    },
    "agent/variance-analysis/severity-rationale": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Per-variance assessment. The comparator already decided that the values differ; this says whether the difference is behavioural or a permitted representation difference, and the prompt forbids dismissing one without naming the normalisation rule that permits it.",
      "type": "object",
      "required": [
        "assessments"
      ],
      "properties": {
        "assessments": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "object",
            "required": [
              "path",
              "behavioural"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "behavioural": {
                "type": "boolean"
              },
              "rationale": {
                "type": "string",
                "maxLength": 2000
              }
            }
          }
        }
      }
    },
    "agent/variance-analysis/parity-check": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "findings": {
          "type": "array",
          "maxItems": 512
        },
        "status": {
          "type": "string"
        }
      }
    },
    "agent/variance-analysis/hardcoding-check": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "findings": {
          "type": "array",
          "maxItems": 512
        },
        "status": {
          "type": "string"
        }
      }
    },
    "agent/rca/hypothesis": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Root cause hypotheses",
      "description": "confidence is not required: the prompt forbids asserting a cause the evidence cannot support, and RCAService scores confidence from evidence coverage deterministically. A model-supplied number here is advisory.",
      "type": "object",
      "required": [
        "hypotheses"
      ],
      "properties": {
        "hypotheses": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "hypothesis"
            ],
            "properties": {
              "hypothesis": {
                "type": "string",
                "minLength": 1
              },
              "supporting_evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 64
              },
              "missing_evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 64
              },
              "affected_scope": {
                "type": "string"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    "agent/remediation/patch-plan": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "A bounded remediation proposal",
      "description": "Proposals only. remediation holds no repository.write tool, so nothing here is applied by this agent -- the contract, not the prompt, is what enforces that. 'bounded' is the model declaring the change stays inside the governed blast radius; the deterministic eligibility check still has to agree.",
      "type": "object",
      "required": [
        "pattern"
      ],
      "properties": {
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "changes": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": [
              "path",
              "intent"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "intent": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 64
        },
        "bounded": {
          "type": "boolean"
        },
        "clarification": {
          "type": "string"
        }
      }
    },
    "agent/dormancy-intelligence/classification-rationale": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": [
        "classification"
      ],
      "properties": {
        "classification": {
          "enum": [
            "ACTIVE",
            "DORMANT",
            "ALREADY_MIGRATED",
            "UNKNOWN"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "decisive_evidence": {
          "type": "string"
        },
        "rationale": {
          "type": "string",
          "maxLength": 4000
        },
        "missing_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 64
        }
      }
    },
    "agent/governance/gate-assessment": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Gate assessment: the model's reading of a transition",
      "description": "A recommendation and its reasoning. The decision stays deterministic -- RBAC, quorum and the artefact hash binding are enforcement, and ACE source text reaches these payloads. Where recommendation and decision disagree, the disagreement is recorded as evidence rather than either side silently winning.",
      "type": "object",
      "required": [
        "recommendation"
      ],
      "properties": {
        "recommendation": {
          "enum": [
            "ALLOW",
            "DENY",
            "INSUFFICIENT_EVIDENCE"
          ]
        },
        "target_state": {
          "type": "string"
        },
        "rationale": {
          "type": "string",
          "maxLength": 4000
        },
        "evidence_sufficient": {
          "type": "boolean"
        },
        "missing_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 64
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 64
        }
      }
    },
    "agent/governance/blocking-explanation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "explanation": {
          "type": "string",
          "maxLength": 4000
        },
        "blocking": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 64
        }
      }
    },
    "agent/knowledge-evidence/citations": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Cited context",
      "type": "object",
      "required": [
        "citations"
      ],
      "properties": {
        "citations": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": [
              "evidence_id"
            ],
            "properties": {
              "evidence_id": {
                "type": "string",
                "minLength": 1
              },
              "claim": {
                "type": "string"
              },
              "locator": {
                "type": "string"
              }
            }
          }
        },
        "uncited_claims": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 64
        }
      }
    },
    "agent/knowledge-evidence/citation-sufficiency": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "sufficient": {
          "type": "boolean"
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 64
        }
      }
    },
    "agent/migration-orchestrator/next-action": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A proposal. The orchestrator still dispatches through AgentRegistry, which re-checks dependencies, roles and the tool allow-list -- so a next_agent the model should not have proposed is refused there, not here.",
      "type": "object",
      "properties": {
        "next_agent": {
          "type": [
            "string",
            "null"
          ]
        },
        "params": {
          "type": "object"
        },
        "next_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "blocked_by": {
          "type": [
            "string",
            "array",
            "null"
          ]
        },
        "rationale": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "agent/feedback/finding-triage": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "findings": {
          "type": "array",
          "maxItems": 256
        },
        "unfixable": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 64
        }
      }
    },
    "agent/feedback/code-repair": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Targeted repair edits",
      "description": "Search/replace rather than whole files, so the model never has to reproduce bytes it was not shown and an old_str that does not match the real file is simply skipped.",
      "type": "object",
      "required": [
        "edits"
      ],
      "properties": {
        "edits": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "path",
              "old_str",
              "new_str"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "old_str": {
                "type": "string",
                "minLength": 1
              },
              "new_str": {
                "type": "string",
                "maxLength": 20000
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "agent/code-generation/project-layout": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "The file set the skill requires for this service",
      "description": "Paths only, decided before any content is written. This is the step springgen.py cannot do: its layout is hardcoded plain Spring Boot, so a skill requiring EIPMS_cvs-v1-<service>-oci with parent and web Maven modules could never be honoured. Each path is confined by workspace.resolve() before it is written, and 'purpose' is what the per-file synthesis call is then asked to produce.",
      "type": "object",
      "required": [
        "files"
      ],
      "properties": {
        "root": {
          "type": "string",
          "maxLength": 200,
          "description": "Repository root directory name the skill prescribes, e.g. EIPMS_cvs-v1-<service>-oci. Empty means generate flat.",
          "pattern": "^[A-Za-z0-9._-]*$"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 400,
          "items": {
            "type": "object",
            "required": [
              "path",
              "purpose"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400,
                "description": "Relative to root, forward slashes, no traversal.",
                "pattern": "^[^/\\\\][^:*?\"<>|]*$"
              },
              "purpose": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "source_reference": {
                "type": "string"
              },
              "skill_reference": {
                "type": "string",
                "description": "Which skill reference prescribes this file, so a reviewer can check the layout against the standard rather than against taste."
              }
            }
          }
        },
        "omitted": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "anyOf": [
              {"type": "string"},
              {
                "type": "object",
                "required": ["path"],
                "properties": {
                  "path": {"type": "string", "minLength": 1},
                  "reason": {"type": "string"}
                }
              }
            ]
          },
          "description": "Files the skill prescribes that this service does not need, each with why. An omission stated is reviewable; a silent one is not."
        }
      }
    }
    ,
    "agent/remediation/code-fix": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Targeted fix edits for static-report findings",
      "description": "Search/replace edits, as for the feedback agent, so the model never reproduces bytes it was not shown. unfixable names the findings it declined rather than guessed at.",
      "type": "object",
      "required": ["edits"],
      "properties": {
        "edits": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["path", "old_str", "new_str"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "old_str": {"type": "string", "minLength": 1},
              "new_str": {"type": "string", "maxLength": 20000},
              "why": {"type": "string"}
            }
          }
        },
        "unfixable": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["ref"],
            "properties": {"ref": {"type": "string"}, "reason": {"type": "string"}}
          }
        }
      }
    }
  }
}
