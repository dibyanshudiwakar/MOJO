# Secrets
*.signing-key
*.secret-key
.env
.env.*

# Databases — contain credentials, password hashes and encrypted tokens
*.db
# WAL journalling leaves these two beside every open database. They hold
# not-yet-checkpointed pages of the same data, so they are as sensitive as
# the .db itself and *.db alone does not match them.
*.db-shm
*.db-wal
# Copies taken before a migration or a governance change. Same contents, same
# sensitivity, and the suffix means *.db does not match them.
*.db.bak*

# Pipeline workspace output — created at runtime, never committed
workspace/
app/orders-migration*/
app/idcard-test*/
idcard-test*/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Virtual Environments
venv/
.venv/

# VS Code
.vscode/
.idea/

# Claude
.claude/scratch/

# Node
node_modules/

# Build Output
dist/
build/

# Logs
*.log